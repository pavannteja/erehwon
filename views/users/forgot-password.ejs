<% layout('layouts/boilerplate')%>

<div class="register-page">
    <div class="register-page__inner">
        <div class="register-card">
            <h1 class="register-card-title">Forgot Password</h1>
            <p class="register-card-subtitle">We'll send a reset link if an account exists for this email.</p>

            <form action="/forgot-password" method="POST" class="validated-form register-form" novalidate>
                <div class="register-field">
                    <label class="register-label" for="email">Email</label>
                    <input class="register-input form-control" type="email" id="email" name="email" placeholder="Enter your email" required autofocus>
                    <div class="valid-feedback">Looks good!</div>
                </div>
                <button type="submit" class="register-btn register-btn--primary">Send reset link</button>
            </form>

            <p class="register-have-account">
                <a href="/login" class="register-link">Back to login</a>
            </p>
        </div>
    </div>
</div>
