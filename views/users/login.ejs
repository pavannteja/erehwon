<% layout('layouts/boilerplate')%>

<div class="register-page">
    <div class="register-page__inner">
        <div class="register-card">
            <h1 class="register-card-title">Login</h1>
            <p class="register-card-subtitle">Sign in to continue your innovation journey.</p>

            <% if (process.env.GOOGLE_CLIENT_ID) { %>
            <div class="register-google-wrap">
                <a href="/auth/google" class="register-btn register-btn--google">
                    <i class="fab fa-google register-btn__icon"></i>
                    <span>Continue with Google</span>
                </a>
                <div class="register-google-stroke" aria-hidden="true"></div>
            </div>

            <p class="register-or">or</p>
            <% } else { %>
            <div class="alert alert-info register-alert">
                <small><i class="fas fa-info-circle me-1"></i>Google OAuth not configured.</small>
            </div>
            <% } %>

            <!-- Individual Login -->
            <form action="/login" method="POST" class="validated-form register-form" novalidate>
                <div class="register-field">
                    <label class="register-label" for="username">Username</label>
                    <input class="register-input form-control" type="text" id="username" name="username" placeholder="Type your username" autofocus required>
                    <div class="valid-feedback">Looks good!</div>
                </div>
                <div class="register-field">
                    <label class="register-label" for="password">Password</label>
                    <input class="register-input form-control" type="password" id="password" name="password" placeholder="Type your password" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="register-forgot-wrap">
                        <a href="/forgot-password" class="register-forgot-link">Forgot password?</a>
                    </div>
                </div>
                <button type="submit" class="register-btn register-btn--primary">Login</button>
            </form>

            <hr class="login-divider">

            <!-- Team Login -->
            <p class="register-card-subtitle login-team-label">Team Login</p>
            <form action="/login" method="POST" class="register-form" novalidate>
                <div class="register-field">
                    <label class="register-label" for="teamUsername">Team Username</label>
                    <input class="register-input form-control" type="text" id="teamUsername" name="username" placeholder="Type your team username" required>
                </div>
                <div class="register-field">
                    <label class="register-label" for="teamPassword">Team Password</label>
                    <input class="register-input form-control" type="password" id="teamPassword" name="password" placeholder="Type your password" required>
                </div>
                <button type="submit" class="register-btn register-btn--secondary">Login as Team</button>
            </form>

            <p class="register-have-account">
                Don't have an account? <a href="/register" class="register-link">Register here</a>
            </p>
        </div>
    </div>
</div>
