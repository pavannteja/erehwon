<% layout('layouts/boilerplate') %>

<style>
.dashboard-container {
    background: #f7f7f7;
    min-height: 100vh;
    padding: 40px 0;
    color: #1d1f21;
}

.dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 30px;
}

.dashboard-title-section h1 {
    font-family: 'Montserrat', sans-serif;
    font-size: 32px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.07em;
    color: #1d1f21;
    margin: 0;
}

.dashboard-title-section p {
    font-family: 'Satoshi', sans-serif;
    font-weight: 500;
    color: #1d1f21;
    font-size: 20px;
    margin: 0;
}

.new-project-btn {
    background: transparent;
    color: #1d1f21;
    border-radius: 8px;
    text-decoration: none;
    font-family: 'Satoshi', sans-serif;
    font-weight: 500;
    font-size: 18px;
    padding: 8px 14px;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    position: relative;
    overflow: hidden;
    z-index: 0;
}

.new-project-btn:hover {
    color: #1d1f21;
    text-decoration: none;
}

.creating-btn {
    background: transparent;
    color: #1d1f21 !important;
    border: 2px solid #ffd700;
    border-radius: 8px;
    text-decoration: none;
    font-family: 'Satoshi', sans-serif;
    font-weight: 500;
    font-size: 18px;
    padding: 8px 14px;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    position: relative;
    overflow: visible;
    z-index: 0;
}

.creating-btn:hover {
    color: #1d1f21 !important;
    text-decoration: none;
}

.new-project-btn::before,
.open-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(247, 247, 247, 1) 0%, rgba(255, 215, 0, 0.6) 100%);
    z-index: -1;
}

.new-project-btn::after,
.open-btn::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(247, 247, 247, 1) 0%, rgba(255, 215, 0, 0.8) 100%);
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: -1;
}

.new-project-btn:hover::after,
.open-btn:hover::after {
    opacity: 1;
}

.dashboard-actions {
    display: flex;
    gap: 20px;
    align-items: center;
}

.projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 24px;
    margin-top: 30px;
}

.project-card {
    background:
        linear-gradient(45deg, rgba(248, 220, 0, 0.15) 0%, rgba(247, 247, 247, 0.15) 100%),
        #ffffff;
    border-radius: 12px;
    padding: 20px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 0 2px rgba(0, 0, 0, 0.25);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 450px;
    overflow: hidden;
}

.project-card:hover {
    border-color: rgba(0, 0, 0, 0.12);
}

.project-card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
}

.project-card-brand {
    display: flex;
    align-items: flex-start;
    min-width: 0;
}

.project-card-logo {
    height: 40px;
    width: auto;
    object-fit: contain;
    flex: 0 0 auto;
}

.project-card-brand-divider {
    width: 0.5px;
    height: 40px;
    background: rgba(0, 0, 0, 0.25);
    margin-left: 10px;
    margin-right: 10px;
    flex: 0 0 auto;
}

.project-card-title {
    margin: 0;
    font-family: 'Montserrat', sans-serif;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 1;
    color: #1d1f21;
}

.project-card-view-link {
    font-family: 'Satoshi', sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    color: rgba(29, 31, 33, 0.9) !important;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
}

.project-card-view-link:hover {
    color: rgba(29, 31, 33, 0.9) !important;
}

.project-card-innovation {
    margin: 18px 0 0 0;
    font-family: 'Satoshi', sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
    color: rgba(29, 31, 33, 0.7);
}

.project-card-pills {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.project-card-pill {
    padding: 3px 8px;
    border-radius: 999px;
    background: #d9d9d9;
    font-family: 'Satoshi', sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
    color: rgba(29, 31, 33, 0.7);
}

.project-card-description {
    margin: 16px 0 0 0;
    color: rgba(29, 31, 33, 0.9);
    font-family: 'Satoshi', sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    flex: 1 1 auto;
    overflow: hidden;
}

.project-progress-meta {
    margin-top: 0;
    display: flex;
    align-items: center;
}

.project-progress-label,
.project-progress-percent {
    font-family: 'Satoshi', sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
    color: rgba(29, 31, 33, 0.7);
}

.project-progress-percent {
    margin-left: auto;
}

.project-progress-track {
    width: 100%;
    height: 10px;
    background: #d9d9d9;
    border-radius: 999px;
    margin-top: 15px;
    overflow: hidden;
}

.project-progress-fill {
    height: 100%;
    background: rgba(255, 215, 0, 0.7);
    border-radius: inherit;
}

.project-card-divider {
    margin-top: 15px;
    border-top: 1px solid rgba(0, 0, 0, 0.25);
}

.project-card-bottom {
    margin-top: 15px;
}

.project-card-footer {
    margin-top: 15px;
    display: flex;
    align-items: center;
}

.open-btn {
    align-self: auto;
    background: transparent;
    border: none;
    color: #1d1f21;
    padding: 10px 12px;
    border-radius: 8px;
    text-decoration: none;
    font-family: 'Satoshi', sans-serif;
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    position: relative;
    overflow: hidden;
    z-index: 0;
}

.open-btn:hover {
    color: #1d1f21;
    text-decoration: none;
}

.project-card-adopted {
    margin: 0 0 0 auto;
    font-family: 'Satoshi', sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.1;
    color: rgba(29, 31, 33, 0.7);
    text-align: right;
}

.empty-state {
    text-align: center;
    padding: 80px 20px;
    background: #111;
    border-radius: 16px;
    border: 1px solid #2a2a2a;
}

.empty-state-icon {
    font-size: 32px;
    color: #ffde00;
    margin-bottom: 20px;
}

.empty-state h2 {
    color: #fff;
    font-size: 22px;
    margin-bottom: 12px;
}

.empty-state p {
    color: #888;
    font-size: 16px;
    margin-bottom: 30px;
}

.empty-state-btn {
    background: #ffde00;
    color: #000;
    padding: 14px 28px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
}

.empty-state-btn:hover {
    background: #e6c800;
    color: #000;
    transform: translateY(-2px);
}

@media (max-width: 768px) {
    .projects-grid {
        grid-template-columns: 1fr;
    }
    
    .dashboard-header {
        flex-direction: column;
        gap: 20px;
    }
}
</style>

<div class="dashboard-container">
    <div class="container">
        <div class="dashboard-header">
            <div class="dashboard-title-section">
                <h1>Your Projects</h1>
                <p>Manage and track your active innovation initiatives</p>
            </div>
            <div class="dashboard-actions">
                <a href="/excite-and-enrol" class="new-project-btn">
                    <i class="fas fa-plus"></i> <%= campgrounds.length === 0 ? 'Create Your First Project' : 'New Project' %>
                </a>
                <% if (currentUser && !currentUser.isTeam) { %>
                <a href="/teams/new" class="creating-btn">
                    <i class="fas fa-users"></i> Create Team
                </a>
                <% } %>
            </div>
        </div>

    <% if(campgrounds.length === 0) { %>
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-lightbulb"></i>
                </div>
                <h2>No Projects Yet</h2>
                <p>Start by creating your first project to begin your innovation journey!</p>
                <div class="dashboard-actions justify-content-center flex-wrap">
                    <a href="/excite-and-enrol" class="empty-state-btn">
                        <i class="fas fa-plus"></i> Create Your First Project
                    </a>
                    <% if (currentUser && !currentUser.isTeam) { %>
                    <a href="/teams/new" class="creating-btn">
                        <i class="fas fa-users"></i> Create Team
                    </a>
                    <% } %>
                </div>
            </div>
        <% } else { %>
            <div class="projects-grid">
                <% campgrounds.forEach(campground => { 
                    // Get team member initials for avatars
                    let teamInitials = [];
                    if (campground.teamInfo && campground.teamInfo.groupMembers) {
                        const members = campground.teamInfo.groupMembers.split(',').map(m => m.trim());
                        teamInitials = members.slice(0, 3).map(m => m.charAt(0).toUpperCase());
                    }
                    // If no group members, use author initial
                    if (teamInitials.length === 0 && campground.author) {
                        teamInitials = [campground.author.username.charAt(0).toUpperCase()];
                    }
                %>
                    <div class="project-card">
                        <div class="project-card-header-row">
                            <div class="project-card-brand">
                                <% const bm = campground.brandMark || { kind: 'image', src: '/images/mission-launch-icon.png', alt: '' }; %>
                                <% if (bm.kind === 'image') { %>
                                <img src="<%= bm.src %>" alt="<%= bm.alt || 'Project logo' %>" class="project-card-logo">
                                <% } else { %>
                                <div class="corporate-problem-card__logo-placeholder project-card-logo-placeholder" aria-hidden="true"><%= bm.letter %></div>
                                <% } %>
                                <span class="project-card-brand-divider" aria-hidden="true"></span>
                                <h3 class="project-card-title"><%= campground.title %></h3>
                            </div>
                            <a href="/problems/<%= campground._id %>" class="project-card-view-link">View Details</a>
                        </div>
                        <p class="project-card-innovation">Incremental Innovation</p>
                        <div class="project-card-pills">
                            <span class="project-card-pill">Ideation</span>
                            <span class="project-card-pill">Market Research</span>
                            <span class="project-card-pill">Strategy</span>
                        </div>
                        <p class="project-card-description">
                            <%= campground.description || campground.problem || 'Innovation project for solving real-world problems' %>
                        </p>

                        <div class="project-card-bottom">
                            <% 
                                const totalPhases = 7;
                                const safeProgress = campground.progress || 0;
                                const completedPhases = Math.max(0, Math.ceil((safeProgress * totalPhases) / 100));
                            %>
                            <div class="project-progress-meta">
                                <span class="project-progress-label">Completed: <%= completedPhases %>/<%= totalPhases %> phases</span>
                                <span class="project-progress-percent"><%= safeProgress %>%</span>
                            </div>
                            <div class="project-progress-track">
                                <div class="project-progress-fill" style="width: <%= safeProgress %>%"></div>
                            </div>
                            <div class="project-card-divider"></div>
                            <div class="project-card-footer">
                                <a href="/problems/<%= campground._id %>" class="open-btn">
                                    Open <i class="fas fa-arrow-right"></i>
                                </a>
                                <p class="project-card-adopted">10+ students have adopted this mission</p>
                            </div>
                        </div>
                    </div>
                <% }); %>
        </div>
    <% } %>
    </div>
</div>
