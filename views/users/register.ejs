<% layout('layouts/boilerplate')%>

<div class="register-page">
    <div class="register-page__inner">
        <div class="register-card">
            <h1 class="register-card-title">Welcome to Erehwon</h1>
            <p class="register-card-subtitle">Start your innovation journey with real industry problems.</p>

            <% if (process.env.GOOGLE_CLIENT_ID) { %>
            <div class="register-google-wrap">
                <a href="/auth/google" class="register-btn register-btn--google">
                    <i class="fab fa-google register-btn__icon"></i>
                    <span>Continue with Google</span>
                </a>
                <div class="register-google-stroke" aria-hidden="true"></div>
            </div>

            <p class="register-or">or</p>
            <% } else { %>
            <div class="alert alert-info register-alert">
                <small><i class="fas fa-info-circle me-1"></i>Google OAuth not configured.</small>
            </div>
            <% } %>

            <form action="/register" method="POST" class="validated-form register-form" novalidate>
                <div class="register-field">
                    <label class="register-label" for="username">Username</label>
                    <input class="register-input form-control" type="text" id="username" name="username" placeholder="Type your username" autofocus required>
                    <div class="valid-feedback">Looks good!</div>
                </div>
                <div class="register-field">
                    <label class="register-label" for="email">Email</label>
                    <input class="register-input form-control" type="email" id="email" name="email" placeholder="Type your email" required>
                    <div class="valid-feedback">Looks good!</div>
                </div>
                <div class="register-field">
                    <label class="register-label" for="password">Password</label>
                    <input class="register-input form-control" type="password" id="password" name="password" placeholder="Type your password" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="register-forgot-wrap">
                        <a href="/forgot-password" class="register-forgot-link">Forgot password?</a>
                    </div>
                </div>
                <button type="submit" class="register-btn register-btn--primary">Register</button>
            </form>

            <p class="register-have-account">
                Already have an account? <a href="/login" class="register-link">Login here</a>
            </p>
        </div>
    </div>
</div>
