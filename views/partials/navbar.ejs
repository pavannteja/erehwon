<nav class="site-nav <%= typeof currentPath !== 'undefined' && (currentPath === '/register' || currentPath === '/login') ? 'site-nav--minimal' : '' %>" aria-label="Primary">
    <div class="site-nav__inner">
        <% if (typeof currentPath !== 'undefined' && (currentPath === '/register' || currentPath === '/login')) { %>
            <a class="site-nav__logo-link site-nav__logo-link--center" href="/">
                <img src="/images/navbar-erehwon-logo.png" alt="Erehwon" class="site-nav__logo" />
            </a>
        <% } else { %>
            <button type="button" class="site-nav__hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav__menu" id="site-nav__hamburger">
                <span class="site-nav__hamburger-bar"></span>
                <span class="site-nav__hamburger-bar"></span>
                <span class="site-nav__hamburger-bar"></span>
            </button>
            <a class="site-nav__logo-link" href="/">
                <img src="/images/navbar-erehwon-logo.png" alt="Erehwon" class="site-nav__logo" />
            </a>
            <div class="site-nav__menu-panel" id="site-nav__menu">
                <% if (currentUser) { %>
                    <div class="site-nav__left-links">
                        <a class="site-nav__text-link" href="https://orbitshift.frappe.cloud/lms/courses?">Build</a>
                        <a class="site-nav__text-link" href="/corporate-problems">Corporate Problems</a>
                        <a class="site-nav__text-link" href="/dashboard">Dashboard</a>
                    </div>
                <% } else { %>
                    <div class="site-nav__left-links">
                        <a class="site-nav__text-link" href="https://orbitshift.frappe.cloud/lms/courses?">Build</a>
                    </div>
                <% } %>
                <div class="site-nav__actions">
                    <% if (currentUser) { %>
                        <a class="site-nav__text-link" href="/logout">Logout</a>
                    <% } else { %>
                        <a class="site-nav__text-link" href="/login">Login</a>
                        <a class="site-nav__get-started" href="/register"><span>Get Started</span></a>
                    <% } %>
                </div>
            </div>
            <div class="site-nav__spacer"></div>
        <% } %>
    </div>
</nav>
<script>
(function() {
    var hamburger = document.getElementById('site-nav__hamburger');
    if (!hamburger) return;
    var menu = document.getElementById('site-nav__menu');
    hamburger.addEventListener('click', function() {
        var open = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', !open);
        this.classList.toggle('site-nav__hamburger--open', !open);
        if (menu) menu.classList.toggle('site-nav__menu--open', !open);
        document.body.classList.toggle('site-nav__body-menu-open', !open);
    });
})();
</script>