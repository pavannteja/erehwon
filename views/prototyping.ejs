<% layout('layouts/boilerplate') %>
<%
  const pid = String(problemId || '');
  const backUrl = pid ? `/problems/${pid}` : '/dashboard';
  const existingFiles = (prototype && Array.isArray(prototype.files)) ? prototype.files : [];
  const existingLinks = (prototype && Array.isArray(prototype.additionalLinks)) ? prototype.additionalLinks.filter((link) => String(link || '').trim().length > 0) : [];
  const hasExistingFiles = existingFiles.length > 0;
%>

<div class="mission-launch-page prototype-page">
  <nav class="mission-launch-timeline" aria-label="Phase progress">
    <ul class="mission-launch-timeline__list">
      <li class="mission-launch-timeline__phase">
        <a href="/excite-and-enrol/mission-launch?campgroundId=<%= pid %>" class="mission-launch-timeline__circle" aria-label="Open Mission Launch">
          <img src="/images/mission-launch-icon.png" alt="" class="mission-launch-timeline__icon-img" aria-hidden="true">
        </a>
        <span class="mission-launch-timeline__label">Mission<br>Launch</span>
      </li>
      <li class="mission-launch-timeline__phase">
        <a href="/process/<%= pid %>/problem-discovery" class="mission-launch-timeline__circle" aria-label="Open Problem Discovery">
          <img src="/images/problem-discovery-icon.png" alt="" class="mission-launch-timeline__icon-img" aria-hidden="true">
        </a>
        <span class="mission-launch-timeline__label">Problem<br>Discovery</span>
      </li>
      <li class="mission-launch-timeline__phase">
        <a href="/process/<%= pid %>/analysis" class="mission-launch-timeline__circle" aria-label="Open Analysis">
          <img src="/images/analysis-icon.png" alt="" class="mission-launch-timeline__icon-img" aria-hidden="true">
        </a>
        <span class="mission-launch-timeline__label">Analysis</span>
      </li>
      <li class="mission-launch-timeline__phase">
        <a href="/process/<%= pid %>/ideation" class="mission-launch-timeline__circle" aria-label="Open Ideation">
          <img src="/images/ideation-icon.png" alt="" class="mission-launch-timeline__icon-img" aria-hidden="true">
        </a>
        <span class="mission-launch-timeline__label">Ideation</span>
      </li>
      <li class="mission-launch-timeline__phase">
        <a href="/process/<%= pid %>/converge" class="mission-launch-timeline__circle" aria-label="Open Converge">
          <img src="/images/converge-icon.png" alt="" class="mission-launch-timeline__icon-img" aria-hidden="true">
        </a>
        <span class="mission-launch-timeline__label">Converge</span>
      </li>
      <li class="mission-launch-timeline__phase">
        <a href="/process/<%= pid %>/solution" class="mission-launch-timeline__circle" aria-label="Open Solution">
          <img src="/images/solution-icon.png" alt="" class="mission-launch-timeline__icon-img" aria-hidden="true">
        </a>
        <span class="mission-launch-timeline__label">Solution</span>
      </li>
      <li class="mission-launch-timeline__phase mission-launch-timeline__phase--active">
        <span class="mission-launch-timeline__circle" aria-current="step">
          <img src="/images/prototype-icon.png" alt="" class="mission-launch-timeline__icon-img" aria-hidden="true">
        </span>
        <span class="mission-launch-timeline__label">Prototype</span>
      </li>
    </ul>
  </nav>

  <div class="mission-launch-main prototype-main">
    <div class="mission-launch-header prototype-header">
      <h1 class="mission-launch-title prototype-title">Phase 7: Prototype</h1>
      <a href="<%= backUrl %>" class="mission-launch-back">Back to Project Overview</a>
    </div>

    <form
      action="/prototyping/<%= pid %>"
      method="POST"
      enctype="multipart/form-data"
      id="prototypeForm"
      class="prototype-form-shell"
      data-existing-count="<%= existingFiles.length %>"
    >
      <input type="hidden" name="title" value="<%= (prototype && prototype.title) ? prototype.title : 'Prototype' %>">
      <input type="hidden" name="prototypeAjax" value="1">

      <section class="prototype-upload-card">
        <div class="prototype-dropzone" id="prototypeDropzone">
          <input
            id="prototypeFiles"
            name="prototypeFiles"
            type="file"
            multiple
            accept=".jpg,.jpeg,.png,.pdf,.mp4,image/jpeg,image/png,application/pdf,video/mp4"
            hidden
          >
          <i class="bi bi-cloud-arrow-up prototype-dropzone__icon" aria-hidden="true"></i>
          <i class="bi bi-file-earmark-text prototype-dropzone__file-icon" aria-hidden="true"></i>
          <p class="prototype-dropzone__file-name" id="prototypeDropzoneFileName"></p>
          <p class="prototype-dropzone__title">Choose a file or drag &amp; drop it here.</p>
          <p class="prototype-dropzone__subtitle">JPEG, PNG, PDF, and MP4 formats, up to 5MB.</p>
          <button type="button" class="prototype-dropzone__btn groundwork-submit-btn" id="prototypeBrowseBtn">Browse File</button>
        </div>
      </section>

      <p class="prototype-file-error" id="prototypeFileError" role="alert" aria-live="polite"></p>
      <ul class="prototype-selected-files" id="prototypeSelectedFiles" aria-live="polite"></ul>

      <section class="prototype-links-block">
        <h2 class="prototype-links-title">Additional Links <span class="prototype-links-title__optional">(Optional)</span></h2>
        <div id="prototypeLinksRows" class="prototype-links-rows">
          <% if (existingLinks.length > 0) { %>
            <% existingLinks.forEach((link, index) => { %>
              <div class="prototype-link-row">
                <input type="url" class="form-control prototype-link-input" name="additionalLinks[]" placeholder="Paste Link" value="<%= link %>">
                <button type="button" class="prototype-link-remove" aria-label="Remove link" style="display: <%= existingLinks.length > 1 ? 'inline-flex' : 'none' %>;">
                  <img src="/images/challenge-intent-close.png" alt="" class="prototype-link-remove__icon" width="13" height="13" aria-hidden="true">
                </button>
              </div>
            <% }) %>
          <% } else { %>
            <div class="prototype-link-row">
              <input type="url" class="form-control prototype-link-input" name="additionalLinks[]" placeholder="Paste Link">
              <button type="button" class="prototype-link-remove" aria-label="Remove link" style="display: none;">
                <img src="/images/challenge-intent-close.png" alt="" class="prototype-link-remove__icon" width="13" height="13" aria-hidden="true">
              </button>
            </div>
          <% } %>
        </div>
        <div class="prototype-plus-wrap">
          <button type="button" class="prototype-plus-btn pd-add-field solution-add-btn" id="prototypeAddLinkBtn" aria-label="Add another link">
            <img src="/images/challenge-intent-plus.png" alt="" class="pd-add-field__icon" width="11" height="11" aria-hidden="true">
          </button>
        </div>
      </section>

      <div class="prototype-save-wrap">
        <button type="submit" class="groundwork-submit-btn prototype-save-btn">
          <span class="groundwork-submit-btn__text">Save</span>
          <span class="groundwork-submit-btn__spinner" aria-hidden="true"></span>
        </button>
      </div>
    </form>

    <section class="prototype-files-list">
      <% if (hasExistingFiles) { %>
        <h3 class="prototype-files-list__title">Attached Files</h3>
        <div class="prototype-file-chips">
          <% existingFiles.forEach((file, index) => { %>
            <article class="prototype-file-chip">
              <a href="<%= file.url %>" class="prototype-file-chip__name" target="_blank" rel="noopener noreferrer"><%= file.filename %></a>
              <button type="button" class="prototype-file-chip__delete btn-delete-file" data-file-index="<%= index %>" aria-label="Delete file <%= file.filename %>">
                <img src="/images/delete-icon.png" alt="" class="prototype-file-chip__delete-icon" aria-hidden="true">
              </button>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</div>

<div id="prototype-delete-confirm-modal" class="delete-confirm-overlay" role="dialog" aria-modal="true" aria-labelledby="prototype-delete-confirm-title" aria-describedby="prototype-delete-confirm-desc" hidden>
  <div class="delete-confirm-backdrop"></div>
  <div class="delete-confirm-dialog">
    <h3 id="prototype-delete-confirm-title" class="delete-confirm-title">Confirm delete</h3>
    <p id="prototype-delete-confirm-desc" class="delete-confirm-question">Are you sure you want to delete this attached file?</p>
    <div class="delete-confirm-actions">
      <button type="button" class="delete-confirm-cancel" id="prototype-delete-confirm-cancel">Cancel</button>
      <button type="button" class="delete-confirm-delete" id="prototype-delete-confirm-delete">Delete</button>
    </div>
  </div>
</div>

<script>
(function () {
  const MIN_LOADING_MS = 2000;
  const MAX_FILE_SIZE = 5 * 1024 * 1024;
  const ALLOWED_MIME_TYPES = new Set(['image/jpeg', 'image/png', 'application/pdf', 'video/mp4']);
  const ALLOWED_EXTENSIONS = new Set(['jpg', 'jpeg', 'png', 'pdf', 'mp4']);

  const form = document.getElementById('prototypeForm');
  const fileInput = document.getElementById('prototypeFiles');
  const fileError = document.getElementById('prototypeFileError');
  const selectedFilesList = document.getElementById('prototypeSelectedFiles');
  const dropzone = document.getElementById('prototypeDropzone');
  const dropzoneFileName = document.getElementById('prototypeDropzoneFileName');
  const browseBtn = document.getElementById('prototypeBrowseBtn');
  const addLinkBtn = document.getElementById('prototypeAddLinkBtn');
  const linksRows = document.getElementById('prototypeLinksRows');
  const saveBtn = form ? form.querySelector('.prototype-save-btn') : null;
  const deleteModal = document.getElementById('prototype-delete-confirm-modal');
  const deleteCancelBtn = document.getElementById('prototype-delete-confirm-cancel');
  const deleteConfirmBtn = document.getElementById('prototype-delete-confirm-delete');
  const initialAttachedFiles = <%- JSON.stringify(existingFiles || []).replace(/</g, '\\u003c') %>;
  let pendingDeleteIndex = null;
  let isSaving = false;
  let currentAttachedFiles = Array.isArray(initialAttachedFiles) ? initialAttachedFiles : [];

  function setButtonLoading(btn, loading) {
    if (!btn) return;
    btn.disabled = loading;
    btn.classList.toggle('groundwork-submit-btn--loading', loading);
    btn.setAttribute('aria-busy', loading ? 'true' : 'false');
  }

  function ensureToastEl() {
    let el = document.getElementById('mission-launch-saved-toast');
    if (!el) {
      el = document.createElement('div');
      el.id = 'mission-launch-saved-toast';
      el.className = 'mission-launch-saved-toast';
      el.setAttribute('role', 'status');
      el.textContent = 'Saved Successfully!';
      document.body.appendChild(el);
    }
    return el;
  }

  function showSavedToast() {
    const el = ensureToastEl();
    el.textContent = 'Saved Successfully!';
    el.classList.remove('mission-launch-saved-toast--hide');
    el.classList.add('mission-launch-saved-toast--show');
    if (el._hideTimer) clearTimeout(el._hideTimer);
    el._hideTimer = setTimeout(function () {
      el.classList.remove('mission-launch-saved-toast--show');
      el.classList.add('mission-launch-saved-toast--hide');
    }, 5000);
  }

  function parseJson(text) {
    try {
      return text ? JSON.parse(text) : null;
    } catch (e) {
      return null;
    }
  }

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function getExtension(filename) {
    const parts = String(filename || '').toLowerCase().split('.');
    return parts.length > 1 ? parts.pop() : '';
  }

  function validateFiles(files) {
    const invalid = [];
    for (const file of files) {
      const ext = getExtension(file.name);
      const validType = ALLOWED_MIME_TYPES.has(file.type) || ALLOWED_EXTENSIONS.has(ext);
      if (!validType) {
        invalid.push(`${file.name} unsupported format`);
        continue;
      }
      if (file.size > MAX_FILE_SIZE) {
        invalid.push(`${file.name} exceeds 5MB`);
      }
    }
    return invalid;
  }

  function renderSelectedFiles(files) {
    selectedFilesList.innerHTML = '';
    if (!files || files.length === 0) return;
  }

  function updateDropzonePreview(files) {
    if (!files || files.length === 0) {
      dropzone.classList.remove('has-file');
      dropzoneFileName.textContent = '';
      return;
    }
    dropzone.classList.add('has-file');
    dropzoneFileName.textContent = files.length === 1 ? files[0].name : `${files.length} files selected`;
  }

  function renderAttachedFiles(files) {
    const section = document.querySelector('.prototype-files-list');
    if (!section) return;
    const safeFiles = Array.isArray(files) ? files : [];
    currentAttachedFiles = safeFiles;
    if (safeFiles.length === 0) {
      section.innerHTML = '';
      form.setAttribute('data-existing-count', '0');
      return;
    }

    const chips = safeFiles.map((file, index) => (
      `<article class="prototype-file-chip">
        <a href="${escapeHtml(file.url)}" class="prototype-file-chip__name" target="_blank" rel="noopener noreferrer">${escapeHtml(file.filename)}</a>
        <button type="button" class="prototype-file-chip__delete btn-delete-file" data-file-index="${index}" aria-label="Delete file ${escapeHtml(file.filename)}">
          <img src="/images/delete-icon.png" alt="" class="prototype-file-chip__delete-icon" aria-hidden="true">
        </button>
      </article>`
    )).join('');

    section.innerHTML = `<h3 class="prototype-files-list__title">Attached Files</h3><div class="prototype-file-chips">${chips}</div>`;
    form.setAttribute('data-existing-count', String(safeFiles.length));
  }

  function setFiles(files) {
    const errors = validateFiles(files);
    if (errors.length > 0) {
      fileInput.value = '';
      renderSelectedFiles([]);
      updateDropzonePreview([]);
      fileError.textContent = errors.join(' | ');
      return false;
    }

    const dt = new DataTransfer();
    files.forEach((file) => dt.items.add(file));
    fileInput.files = dt.files;
    renderSelectedFiles(Array.from(fileInput.files));
    updateDropzonePreview(Array.from(fileInput.files));
    fileError.textContent = '';
    return true;
  }

  fileInput.addEventListener('change', function () {
    setFiles(Array.from(fileInput.files));
  });

  browseBtn.addEventListener('click', function () {
    fileInput.click();
  });

  ['dragenter', 'dragover'].forEach((eventName) => {
    dropzone.addEventListener(eventName, function (event) {
      event.preventDefault();
      event.stopPropagation();
      dropzone.classList.add('is-dragover');
    });
  });

  ['dragleave', 'drop'].forEach((eventName) => {
    dropzone.addEventListener(eventName, function (event) {
      event.preventDefault();
      event.stopPropagation();
      dropzone.classList.remove('is-dragover');
    });
  });

  dropzone.addEventListener('drop', function (event) {
    const droppedFiles = Array.from(event.dataTransfer.files || []);
    if (droppedFiles.length > 0) {
      setFiles(droppedFiles);
    }
  });

  function createLinkRow(value) {
    const row = document.createElement('div');
    row.className = 'prototype-link-row';

    const input = document.createElement('input');
    input.type = 'url';
    input.className = 'form-control prototype-link-input';
    input.name = 'additionalLinks[]';
    input.placeholder = 'Paste Link';
    input.value = value || '';

    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'prototype-link-remove';
    removeBtn.setAttribute('aria-label', 'Remove link');
    removeBtn.innerHTML = '<img src="/images/challenge-intent-close.png" alt="" class="prototype-link-remove__icon" width="13" height="13" aria-hidden="true">';

    row.appendChild(input);
    row.appendChild(removeBtn);
    return row;
  }

  function syncLinkRemoveButtons() {
    const rows = Array.from(linksRows.querySelectorAll('.prototype-link-row'));
    rows.forEach((row) => {
      const removeBtn = row.querySelector('.prototype-link-remove');
      if (!removeBtn) return;
      removeBtn.style.display = rows.length > 1 ? 'inline-flex' : 'none';
    });
  }

  addLinkBtn.addEventListener('click', function () {
    const row = createLinkRow('');
    linksRows.appendChild(row);
    syncLinkRemoveButtons();
    const input = row.querySelector('.prototype-link-input');
    if (input) input.focus();
  });

  linksRows.addEventListener('click', function (event) {
    const removeBtn = event.target.closest('.prototype-link-remove');
    if (!removeBtn) return;
    const rows = linksRows.querySelectorAll('.prototype-link-row');
    if (rows.length <= 1) return;
    const row = removeBtn.closest('.prototype-link-row');
    if (row) row.remove();
    syncLinkRemoveButtons();
  });

  syncLinkRemoveButtons();
  updateDropzonePreview(Array.from(fileInput.files || []));

  form.addEventListener('submit', function (event) {
    event.preventDefault();
    event.stopPropagation();

    if (isSaving) return;

    const existingCount = Number(form.getAttribute('data-existing-count') || '0');
    const selectedCount = fileInput.files ? fileInput.files.length : 0;
    if (existingCount === 0 && selectedCount === 0) {
      fileError.textContent = 'Please upload at least one file to continue.';
      return;
    }
    const errors = validateFiles(Array.from(fileInput.files || []));
    if (errors.length > 0) {
      fileError.textContent = errors.join(' | ');
      setButtonLoading(saveBtn, false);
      return;
    }

    isSaving = true;
    const start = Date.now();
    setButtonLoading(saveBtn, true);

    fetch(form.getAttribute('action'), {
      method: 'POST',
      body: new FormData(form),
      credentials: 'same-origin',
      headers: { Accept: 'application/json' }
    })
      .then(function (res) {
        return res.text().then(function (text) {
          return { ok: res.ok, data: parseJson(text) };
        });
      })
      .then(function (ref) {
        if (!ref.ok || !ref.data || !ref.data.ok) {
          const msg = ref.data && ref.data.error ? ref.data.error : 'Could not save. Please try again.';
          window.alert(msg);
          return;
        }
        const elapsed = Date.now() - start;
        const waitMore = Math.max(0, MIN_LOADING_MS - elapsed);
        return new Promise(function (resolve) {
          setTimeout(resolve, waitMore);
        }).then(function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
          setTimeout(showSavedToast, 150);
          const serverFiles = Array.isArray(ref.data.files) ? ref.data.files : null;
          const nextFiles = serverFiles && (serverFiles.length > 0 || currentAttachedFiles.length === 0)
            ? serverFiles
            : currentAttachedFiles;
          renderAttachedFiles(nextFiles);
          fileInput.value = '';
          renderSelectedFiles([]);
          updateDropzonePreview([]);
        });
      })
      .catch(function () {
        window.alert('Network error. Please try again.');
      })
      .finally(function () {
        isSaving = false;
        setButtonLoading(saveBtn, false);
      });
  });

  function openDeleteModal(fileIndex) {
    pendingDeleteIndex = fileIndex;
    if (!deleteModal) return;
    deleteModal.hidden = false;
    document.body.style.overflow = 'hidden';
    if (deleteConfirmBtn) deleteConfirmBtn.focus();
  }

  function closeDeleteModal() {
    if (!deleteModal) return;
    deleteModal.hidden = true;
    pendingDeleteIndex = null;
    document.body.style.overflow = '';
  }

  document.addEventListener('click', function (event) {
    const btn = event.target.closest('.btn-delete-file');
    if (!btn) return;
    const fileIndex = btn.getAttribute('data-file-index');
    openDeleteModal(fileIndex);
  });

  if (deleteCancelBtn) {
    deleteCancelBtn.addEventListener('click', closeDeleteModal);
  }

  if (deleteModal) {
    deleteModal.addEventListener('click', function (event) {
      if (event.target.classList.contains('delete-confirm-backdrop')) closeDeleteModal();
    });
  }

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && deleteModal && !deleteModal.hidden) closeDeleteModal();
  });

  if (deleteConfirmBtn) {
    deleteConfirmBtn.addEventListener('click', async function () {
      if (pendingDeleteIndex === null || pendingDeleteIndex === undefined) {
        closeDeleteModal();
        return;
      }

      const problemId = '<%= problemId %>';
      try {
        const response = await fetch(`/prototyping/${problemId}/file/${pendingDeleteIndex}`, { method: 'DELETE' });
        if (response.ok) {
          closeDeleteModal();
          location.reload();
          return;
        }
        const error = await response.json();
        alert(error.error || 'Failed to delete file');
      } catch (error) {
        console.error('Error deleting file:', error);
        alert('Failed to delete file. Please try again.');
      }
    });
  }
})();
</script>

