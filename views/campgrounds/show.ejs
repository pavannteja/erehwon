(function () {
    var form = document.getElementById('notesForm');
    if (!form) return;
    var MIN_LOADING_MS = 2000;
    var select = document.getElementById('po-note-slot');
    var addBtn = document.getElementById('po-add-note-btn');
    var deleteBtn = document.getElementById('po-delete-note-btn');
    var textarea = form.querySelector('textarea[name="notes"]');
    var payload = document.getElementById('po-notes-payload');
    var submitBtn = form.querySelector('button[type="submit"]');
    var initialStateEl = document.getElementById('po-notes-initial-state');
    var deleteModal = document.getElementById('delete-note-confirm-modal');
    var deleteCancel = document.getElementById('delete-note-confirm-cancel');
    var deleteConfirm = document.getElementById('delete-note-confirm-delete');
    if (!select || !addBtn || !deleteBtn || !textarea || !payload || !submitBtn || !deleteModal || !deleteCancel || !deleteConfirm) return;

    function ensureToastEl() {
        var el = document.getElementById('mission-launch-saved-toast');
        if (!el) {
            el = document.createElement('div');
            el.id = 'mission-launch-saved-toast';
            el.className = 'mission-launch-saved-toast';
            el.setAttribute('role', 'status');
            el.textContent = 'Saved Successfully!';
            document.body.appendChild(el);
        }
        return el;
    }

    function showSavedToast(message) {
        var el = ensureToastEl();
        el.textContent = message || 'Saved Successfully!';
        el.classList.remove('mission-launch-saved-toast--hide');
        el.classList.add('mission-launch-saved-toast--show');
        if (el._hideTimer) clearTimeout(el._hideTimer);
        el._hideTimer = setTimeout(function () {
            el.classList.remove('mission-launch-saved-toast--show');
            el.classList.add('mission-launch-saved-toast--hide');
        }, 5000);
    }

    function parseJsonResponse(text) {
        try {
            return text ? JSON.parse(text) : null;
        } catch (e) {
            return null;
        }
    }

    function setButtonLoading(loading) {
        submitBtn.disabled = loading;
        submitBtn.classList.toggle('groundwork-submit-btn--loading', loading);
        submitBtn.setAttribute('aria-busy', loading ? 'true' : 'false');
    }

    var notesState = [];
    if (initialStateEl && initialStateEl.textContent) {
        try {
            var parsed = JSON.parse(initialStateEl.textContent);
            if (Array.isArray(parsed)) {
                notesState = parsed.map(function (slot) {
                    return typeof slot === 'string' ? slot : '';
                });
            }
        } catch (e) {
            notesState = [];
        }
    }
    if (!notesState.length) {
        for (var i = 0; i < select.options.length; i++) notesState.push('');
    }
    while (notesState.length < select.options.length) notesState.push('');
    var activeIndex = Math.max(0, (parseInt(select.value, 10) || 1) - 1);
    if (typeof notesState[activeIndex] !== 'string') notesState[activeIndex] = '';
    textarea.value = notesState[activeIndex] || '';

    function syncTextareaFromSlot() {
        textarea.value = notesState[activeIndex] || '';
    }

    function persistCurrentSlot() {
        notesState[activeIndex] = textarea.value || '';
    }

    function addSlotOption(slotNumber) {
        var option = document.createElement('option');
        option.value = String(slotNumber);
        option.textContent = 'Note ' + slotNumber;
        select.appendChild(option);
    }

    function rebuildOptions() {
        select.innerHTML = '';
        for (var i = 0; i < notesState.length; i++) addSlotOption(i + 1);
        if (activeIndex < 0) activeIndex = 0;
        if (activeIndex >= notesState.length) activeIndex = notesState.length - 1;
        select.value = String(activeIndex + 1);
        syncTextareaFromSlot();
    }

    function openDeleteModal() {
        deleteModal.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        deleteModal.setAttribute('hidden', '');
        document.body.style.overflow = '';
    }

    function deleteCurrentNote() {
        persistCurrentSlot();
        if (notesState.length > 1) {
            notesState.splice(activeIndex, 1);
            if (activeIndex >= notesState.length) activeIndex = notesState.length - 1;
        } else {
            notesState[0] = '';
            activeIndex = 0;
        }
        rebuildOptions();
        textarea.focus();
    }

    select.addEventListener('change', function () {
        persistCurrentSlot();
        activeIndex = Math.max(0, (parseInt(select.value, 10) || 1) - 1);
        if (typeof notesState[activeIndex] !== 'string') notesState[activeIndex] = '';
        syncTextareaFromSlot();
    });

    addBtn.addEventListener('click', function () {
        persistCurrentSlot();
        notesState.push('');
        var newIndex = notesState.length - 1;
        addSlotOption(newIndex + 1);
        select.value = String(newIndex + 1);
        activeIndex = newIndex;
        syncTextareaFromSlot();
        textarea.focus();
    });

    deleteBtn.addEventListener('click', function () {
        openDeleteModal();
    });

    deleteCancel.addEventListener('click', function () {
        closeDeleteModal();
    });

    deleteConfirm.addEventListener('click', function () {
        deleteCurrentNote();
        closeDeleteModal();
    });

    deleteModal.addEventListener('click', function (e) {
        if (e.target.classList.contains('delete-confirm-backdrop')) closeDeleteModal();
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var start = Date.now();
        setButtonLoading(true);
        persistCurrentSlot();
        payload.value = JSON.stringify(notesState.map(function (slot) {
            return typeof slot === 'string' ? slot : '';
        }));
        var params = new URLSearchParams(new FormData(form));
        params.set('notesAjax', '1');
        fetch(form.getAttribute('action'), {
            method: 'POST',
            body: params,
            credentials: 'same-origin',
            headers: {
                Accept: 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded'
            }
        })
            .then(function (res) {
                return res.text().then(function (text) {
                    return { res: res, data: parseJsonResponse(text) };
                });
            })
            .then(function (ref) {
                var res = ref.res;
                var data = ref.data;
                if (!res.ok || !data || !data.ok) {
                    var msg = data && data.error ? data.error : 'Could not save. Please try again.';
                    window.alert(msg);
                    return;
                }
                var elapsed = Date.now() - start;
                var waitMore = Math.max(0, MIN_LOADING_MS - elapsed);
                return new Promise(function (resolve) {
                    setTimeout(resolve, waitMore);
                }).then(function () {
                    showSavedToast('Saved Successfully!');
                });
            })
            .catch(function () {
                window.alert('Network error. Please try again.');
            })
            .finally(function () {
                setButtonLoading(false);
            });
    });
})();

