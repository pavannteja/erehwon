        el._hideTimer = setTimeout(function () {
            el.classList.remove('mission-launch-saved-toast--show');
            el.classList.add('mission-launch-saved-toast--hide');
        }, 5000);
    }

    function parseJsonResponse(text) {
        try {
            return text ? JSON.parse(text) : null;
        } catch (e) {
            return null;
        }
    }

    function setDeleteButtonLoading(loading) {
        deleteConfirm.disabled = loading;
        deleteConfirm.classList.toggle('delete-confirm-delete--loading', loading);
        deleteConfirm.setAttribute('aria-busy', loading ? 'true' : 'false');
    }

    function openDeleteModal(formEl) {
        pendingDeleteForm = formEl;
        deleteModal.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        deleteModal.setAttribute('hidden', '');
        document.body.style.overflow = '';
        pendingDeleteForm = null;
    }

    function syncReviewsEmptyState() {
        var track = reviewsSection.querySelector('#po-reviews-track');
        if (track && track.children.length === 0) {
            var carousel = reviewsSection.querySelector('.po-reviews-carousel');
            if (carousel) carousel.remove();
            var existingEmpty = reviewsSection.querySelector('.po-section-lead');
            if (!existingEmpty) {
                var p = document.createElement('p');
                p.className = 'po-section-lead';
                p.style.marginBottom = '0';
                p.textContent = 'No reviews yet. Be the first to share feedback.';
                reviewsSection.appendChild(p);
            }
        }
    }

    function submitDelete(formEl) {
        var payload = new URLSearchParams();
        payload.set('reviewsDeleteAjax', '1');
        return fetch(formEl.getAttribute('action'), {
            method: 'POST',
            body: payload,
            credentials: 'same-origin',
            headers: {
                Accept: 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded'
            }
        })
            .then(function (res) {
                return res.text().then(function (text) {
                    return { res: res, data: parseJsonResponse(text) };
                });
            })
            .then(function (ref) {
                if (!ref.res.ok || !ref.data || !ref.data.ok) {
                    var msg = ref.data && ref.data.error ? ref.data.error : 'Could not delete review. Please try again.';
                    window.alert(msg);
                    return;
                }
                var card = formEl.closest('.po-review-card');
                if (card) card.remove();
                closeDeleteModal();
                syncReviewsEmptyState();
                showSavedToast('Deleted Successfully!');
            })
            .catch(function () {
                window.alert('Network error. Please try again.');
            });
    }

    reviewsSection.addEventListener('click', function (e) {
        var trigger = e.target.closest('.po-review-delete-trigger');
        if (!trigger) return;
        e.preventDefault();
        var formId = trigger.getAttribute('data-form-id');
        if (!formId) return;
        var formEl = document.getElementById(formId);
        if (!formEl) return;
        openDeleteModal(formEl);
    });

    deleteCancel.addEventListener('click', closeDeleteModal);
    deleteModal.addEventListener('click', function (e) {
        if (e.target.classList.contains('delete-confirm-backdrop')) closeDeleteModal();
    });
    deleteConfirm.addEventListener('click', function () {
        if (!pendingDeleteForm) return;
        var targetForm = pendingDeleteForm;
        setDeleteButtonLoading(true);
        submitDelete(targetForm).finally(function () {
            setDeleteButtonLoading(false);
        });
    });
})();

(function () {
    function bindConfirmModal(config) {
        var trigger = document.getElementById(config.triggerId);
        var modal = document.getElementById(config.modalId);
        var cancelBtn = document.getElementById(config.cancelId);
        var confirmBtn = document.getElementById(config.confirmId);
        var form = document.getElementById(config.formId);
        if (!trigger || !modal || !cancelBtn || !confirmBtn || !form) return;

        function openModal() {
            modal.removeAttribute('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            modal.setAttribute('hidden', '');
            document.body.style.overflow = '';
        }

        trigger.addEventListener('click', openModal);
        cancelBtn.addEventListener('click', closeModal);
        confirmBtn.addEventListener('click', function () {
            form.submit();
        });
        modal.addEventListener('click', function (e) {
            if (e.target.classList.contains('delete-confirm-backdrop')) closeModal();
        });
    }

    bindConfirmModal({
        triggerId: 'po-delete-problem-trigger',
        modalId: 'po-delete-problem-confirm-modal',
        cancelId: 'po-delete-problem-confirm-cancel',
        confirmId: 'po-delete-problem-confirm-delete',
        formId: 'po-delete-problem-form'
    });

    bindConfirmModal({
        triggerId: 'po-unadopt-problem-trigger',
        modalId: 'po-unadopt-problem-confirm-modal',
        cancelId: 'po-unadopt-problem-confirm-cancel',
        confirmId: 'po-unadopt-problem-confirm-delete',
        formId: 'po-unadopt-problem-form'
    });
})();
</script>
