            deleteForm.innerHTML = '<button type="button" class="po-btn-danger-outline po-btn-delete-with-icon po-review-delete-trigger" data-form-id="' + dynamicReviewFormId + '" aria-haspopup="dialog" aria-controls="po-review-delete-confirm-modal"><img src="/images/delete-icon.png" alt="" class="prototype-file-chip__delete-icon" width="14" height="14" aria-hidden="true"><span>Delete</span></button>';
            article.appendChild(deleteForm);
        }

        track.appendChild(article);
