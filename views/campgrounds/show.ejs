        var epsilon = 2;
        function setBtnVisibility(btn, shouldShow) {
            if (!btn) return;
            btn.style.display = shouldShow ? 'flex' : 'none';
            btn.setAttribute('aria-hidden', shouldShow ? 'false' : 'true');
            btn.disabled = !shouldShow;
        }
        function updateChevronState() {
