        var rating = Math.max(0, Math.min(5, parseInt(reviewData.rating, 10) || 0));
        var body = reviewData.body == null ? '' : String(reviewData.body);
        var username = reviewData.author && reviewData.author.username ? String(reviewData.author.username) : 'You';
        var reviewId = reviewData.id ? String(reviewData.id) : '';

        var article = document.createElement('article');
        article.className = 'po-review-card';

