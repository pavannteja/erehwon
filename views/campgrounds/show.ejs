<% layout('layouts/boilerplate') %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet">
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/stylesheets/stars.css">

<%
// Check which phases are actually completed
let phaseCompleted = {
    1: false,
    2: false,
    3: false,
    4: false,
    5: false,
    6: false,
    7: false
};

if ((campground.teamInfo && campground.teamInfo.schoolName) ||
    (campground.missionLaunchGroundworkInfo && campground.missionLaunchGroundworkInfo.schoolName)) {
    phaseCompleted[1] = true;
}

if (campground.problemStatementInfo && campground.problemStatementInfo.problemType) {
    phaseCompleted[2] = true;
}

if (phaseCompleted[2]) {
    phaseCompleted[3] = true;
}

if (typeof ideaCount !== 'undefined' && ideaCount >= 10) {
    phaseCompleted[4] = true;
}

if (phaseCompleted[4]) {
    phaseCompleted[5] = true;
}

if (campground.solution) {
    phaseCompleted[6] = true;
}

if (typeof prototypeHasFiles !== 'undefined' && prototypeHasFiles) {
    phaseCompleted[7] = true;
}

let currentStage = 1;
for (let i = 1; i <= 7; i++) {
    if (!phaseCompleted[i]) {
        currentStage = i;
        break;
    }
    if (i === 7 && phaseCompleted[7]) {
        currentStage = 7;
    }
}

const phases = [
    { key: 'excite-enrol', name: 'Mission Launch', iconFile: 'mission-launch-icon.png', description: 'Build your team and get enrolled' },
    { key: 'problem-discovery', name: 'Problem Discovery', iconFile: 'problem-discovery-icon.png', description: 'Research and understand the problem' },
    { key: 'analysis', name: 'Analysis', iconFile: 'analysis-icon.png', description: 'Analyze findings and identify key patterns' },
    { key: 'ideation', name: 'Ideation', iconFile: 'ideation-icon.png', description: 'Generate creative solutions' },
    { key: 'converge-ideas', name: 'Converge', iconFile: 'converge-icon.png', description: 'Narrow ideas and select the best direction' },
    { key: 'conceptual-solution', name: 'Solution', iconFile: 'solution-icon.png', description: 'Define and refine your solution' },
    { key: 'prototyping', name: 'Prototype', iconFile: 'prototype-icon.png', description: 'Build and test your prototype' }
];

function overviewPhaseHref(key) {
    if (!campground || !campground._id) return '#';
    if (key === 'excite-enrol') return '/excite-and-enrol?campgroundId=' + campground._id;
    return '/process/' + campground._id + '/' + key;
}

const resumeHref = overviewPhaseHref(phases[currentStage - 1].key);
const gwShow = campground.missionLaunchGroundworkInfo || {};
const tiShow = campground.teamInfo || {};
const corp = campground.adoptedFromCorporateProblem;
const subtitle = (corp && corp.companyName)
    ? corp.companyName
    : (gwShow.schoolName || tiShow.schoolName || 'Innovation project');
const challengeText = campground.problem || campground.description || 'Describe the challenge your team is working on.';
const ps = campground.problemStatementInfo || {};
const customPs = ps.customProblem || {};
const objectiveText = customPs.expectedBenefit || campground.description || challengeText;
const notesRaw = campground.notes || '';
let noteSlots = [];
if (typeof notesRaw === 'string') {
    try {
        const parsedNotes = JSON.parse(notesRaw);
        if (Array.isArray(parsedNotes)) {
            noteSlots = parsedNotes.map(function (slot) {
                return typeof slot === 'string' ? slot : '';
            });
        }
    } catch (e) {
        noteSlots = [];
    }
}
if (!noteSlots.length) noteSlots = [String(notesRaw || '')];
const reviewCount = campground.reviews ? campground.reviews.length : 0;
const canEditProject = currentUser && (
    (campground.author && typeof campground.author.equals === 'function' && campground.author.equals(currentUser._id))
    || currentUser.isAdmin
);
%>

<div class="mission-launch-page project-overview-page">
    <div class="po-stack">
        <header class="po-card po-hero" aria-label="Project header">
            <div class="po-hero-brand">
                <% if (brandMark.kind === 'image') { %>
                <img src="<%= brandMark.src %>" alt="<%= brandMark.alt %>" class="po-hero-logo" width="52" height="52"<%= brandMark.alt ? '' : ' aria-hidden="true"' %>>
                <% } else { %>
                <div class="po-hero-logo po-hero-logo--initial" role="img" aria-label="<%= subtitle %> logo"><%= brandMark.letter %></div>
                <% } %>
                <div class="po-hero-titles">
                    <h1 class="po-hero-title"><%= campground.title %></h1>
                    <p class="po-hero-sub"><%= subtitle %></p>
                </div>
            </div>
            <a href="<%= resumeHref %>" class="po-resume-btn groundwork-submit-btn"><span class="groundwork-submit-btn__text">Resume project</span></a>
        </header>

        <section class="po-card" aria-labelledby="po-challenge-heading">
            <h2 class="po-label" id="po-challenge-heading">Challenge:</h2>
            <p class="po-body"><%= challengeText %></p>
            <h2 class="po-label">Objective:</h2>
            <p class="po-body"><%= objectiveText %></p>
        </section>

        <section class="po-card" aria-labelledby="po-status-heading">
            <h2 class="po-section-title" id="po-status-heading">Project Status</h2>
            <nav class="po-status-track" aria-label="Phase progress">
                <ul class="po-status-track__list">
                    <% phases.forEach((phase, index) => {
                        const phaseNum = index + 1;
                        const inProgress = phaseNum <= currentStage;
                        const href = overviewPhaseHref(phase.key);
                    %>
                    <% if (index > 0) { %>
                    <li class="po-status-track__gap" aria-hidden="true"></li>
                    <% } %>
                    <li class="po-status-track__label">
                        <a href="<%= href %>" class="po-status-track__link<%= inProgress ? ' po-status-track__link--progress' : '' %>"><%= phase.name %></a>
                    </li>
                    <% }); %>
                </ul>
            </nav>
            <p class="po-status-meta"><%= reviewCount %> <%= reviewCount === 1 ? 'review' : 'reviews' %> | You are in Phase <%= currentStage %> of 7</p>
        </section>

        <section class="po-card" aria-labelledby="po-images-heading">
            <h2 class="po-section-title" id="po-images-heading">Problem Images</h2>
            <p class="po-section-lead po-section-lead--full">Document the problem. Upload visual evidence showing the problem&rsquo;s nature, its real-world occurrence, and the specific hurdles preventing a breakthrough.</p>
            <% if (canEditProject) { %>
            <form action="/problems/<%= campground._id %>/images" method="POST" enctype="multipart/form-data" id="po-image-upload-form">
                <section class="prototype-upload-card">
                    <div class="prototype-dropzone" id="poProblemImageDropzone">
                        <input type="file" id="po-image-input" name="image" multiple accept="image/jpeg,image/png,.jpg,.jpeg,.png" hidden aria-label="Choose images to upload">
                        <i class="bi bi-cloud-arrow-up prototype-dropzone__icon" aria-hidden="true"></i>
                        <i class="bi bi-file-earmark-text prototype-dropzone__file-icon" aria-hidden="true"></i>
                        <p class="prototype-dropzone__file-name" id="poDropzoneFileName"></p>
                        <p class="prototype-dropzone__title">Choose a file or drag &amp; drop it here.</p>
                        <p class="prototype-dropzone__subtitle">JPEG, PNG formats, up to 5MB.</p>
                        <button type="button" class="prototype-dropzone__btn groundwork-submit-btn" id="poProblemBrowseBtn">Browse File</button>
                    </div>
                </section>
                <p class="prototype-file-error" id="poProblemFileError" role="alert" aria-live="polite"></p>
                <ul class="prototype-selected-files" id="poProblemSelectedFiles" aria-live="polite"></ul>
                <div class="prototype-save-wrap">
                    <button type="submit" class="groundwork-submit-btn prototype-save-btn"><span class="groundwork-submit-btn__text">Upload</span></button>
                </div>
            </form>
            <% } else { %>
            <section class="prototype-upload-card">
                <div class="prototype-dropzone po-prototype-dropzone--locked" aria-disabled="true">
                    <i class="bi bi-lock prototype-dropzone__icon" aria-hidden="true"></i>
                    <p class="prototype-dropzone__title">Only the project owner can upload images</p>
                    <p class="prototype-dropzone__subtitle">Sign in as the project owner to add problem images.</p>
                </div>
            </section>
            <% } %>

            <% if (campground.images && campground.images.length > 0) { %>
            <ul class="po-file-list" aria-label="Uploaded files">
                <% campground.images.forEach((img) => { %>
                <li><a href="<%= img.url %>" target="_blank" rel="noopener noreferrer"><%= img.filename || 'Image' %></a></li>
                <% }); %>
            </ul>
            <div class="po-images-grid">
                <% campground.images.forEach((img) => { %>
                <div class="po-image-tile">
                    <img src="<%= img.url %>" alt="Problem image">
                    <% if (canEditProject) { %>
                    <form class="po-image-delete" action="/problems/<%= campground._id %>/images/<%= img.filename %>?_method=DELETE" method="POST">
                        <button type="submit" class="po-delete-icon-btn" onclick="return confirm('Delete this image?')" aria-label="Delete image">
                            <img src="/images/delete-icon.png" alt="" class="prototype-file-chip__delete-icon" width="14" height="14" aria-hidden="true">
                        </button>
                    </form>
                    <% } %>
                </div>
                <% }); %>
            </div>
            <% } %>
        </section>

        <% if (currentUser) { %>
        <section class="po-card" aria-labelledby="po-notes-heading">
            <h2 class="po-section-title" id="po-notes-heading">Notes</h2>
            <% if (canEditProject) { %>
            <div class="po-notes-toolbar">
                <div class="po-notes-select-shell">
                    <label class="visually-hidden" for="po-note-slot">Note</label>
                    <select class="form-select po-notes-select" id="po-note-slot" name="noteSlot" aria-label="Note slot">
                        <% noteSlots.forEach(function (_, idx) { %>
                        <option value="<%= idx + 1 %>">Note <%= idx + 1 %></option>
                        <% }); %>
                    </select>
                    <span class="po-notes-select-chevron" aria-hidden="true"><i class="bi bi-chevron-down"></i></span>
                </div>
                <div class="po-notes-actions">
                    <button type="button" class="po-notes-add-btn" id="po-add-note-btn">Add Note</button>
                    <span class="po-notes-action-divider" aria-hidden="true">|</span>
                    <button
                        type="button"
                        class="po-notes-delete-btn"
                        id="po-delete-note-btn"
                        aria-haspopup="dialog"
                        aria-controls="delete-note-confirm-modal"
                    >Delete</button>
                </div>
            </div>
            <form action="/problems/<%= campground._id %>/notes" method="POST" id="notesForm">
                <textarea name="notes" class="po-textarea" rows="6" placeholder="Add your notes here..."><%= noteSlots[0] || '' %></textarea>
                <input type="hidden" name="notesPayload" id="po-notes-payload" value="">
                <div class="po-notes-footer">
                    <button type="submit" class="groundwork-submit-btn">
                        <span class="groundwork-submit-btn__text">Save note</span>
                        <span class="groundwork-submit-btn__spinner" aria-hidden="true"></span>
                    </button>
                    <a href="/ideation/my-brainstorms?problemId=<%= campground._id %>" class="po-link-muted">View my brainstorm</a>
                </div>
            </form>
            <script type="application/json" id="po-notes-initial-state"><%- JSON.stringify(noteSlots) %></script>
            <div id="delete-note-confirm-modal" class="delete-confirm-overlay" role="dialog" aria-modal="true" aria-labelledby="delete-note-confirm-title" aria-describedby="delete-note-confirm-desc" hidden>
                <div class="delete-confirm-backdrop"></div>
                <div class="delete-confirm-dialog">
                    <h3 id="delete-note-confirm-title" class="delete-confirm-title">Confirm delete</h3>
                    <p id="delete-note-confirm-desc" class="delete-confirm-question">Are you sure you want to delete this note?</p>
                    <div class="delete-confirm-actions">
                        <button type="button" class="delete-confirm-cancel" id="delete-note-confirm-cancel">Cancel</button>
                        <button type="button" class="delete-confirm-delete" id="delete-note-confirm-delete">Delete</button>
                    </div>
                </div>
            </div>
            <% } else { %>
            <% const nonEmptyNotes = noteSlots.filter(function (slot) { return String(slot || '').trim().length > 0; }); %>
            <% if (nonEmptyNotes.length) { %>
            <div class="po-notes-readonly-list">
                <% nonEmptyNotes.forEach(function (slot, idx) { %>
                <p class="po-body" style="white-space:pre-wrap; margin-bottom:0.6rem;"><strong>Note <%= idx + 1 %>:</strong> <%= slot %></p>
                <% }); %>
            </div>
            <% } else { %>
            <p class="po-body" style="white-space:pre-wrap">No notes yet.</p>
            <% } %>
            <% } %>
        </section>
        <% } %>

        <section class="po-card" aria-labelledby="po-reviews-heading">
            <h2 class="po-section-title" id="po-reviews-heading">Reviews &amp; Feedback</h2>

            <% if (currentUser) { %>
            <div class="po-review-form-wrap">
                <form action="/problems/<%= campground._id %>/reviews" method="POST" class="validated-form" novalidate>
                    <fieldset class="starability-basic mb-2">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                    <textarea name="review[body]" class="po-textarea" placeholder="Share your thoughts and feedback..." required></textarea>
                    <button type="submit" class="groundwork-submit-btn">
                        <span class="groundwork-submit-btn__text">Submit review</span>
                        <span class="groundwork-submit-btn__spinner" aria-hidden="true"></span>
                    </button>
                </form>
            </div>
            <% } %>

            <% if (campground.reviews && campground.reviews.length > 0) { %>
            <div class="po-reviews-carousel">
                <button type="button" class="po-scroll-btn po-scroll-btn--prev" aria-label="Scroll reviews left"><i class="fas fa-chevron-left"></i></button>
                <div class="po-reviews-track" id="po-reviews-track">
                    <% campground.reviews.forEach(review => { %>
                    <article class="po-review-card">
                        <div class="po-review-card-top">
                            <div class="po-review-user">
                                <div class="po-review-avatar" aria-hidden="true"><%= review.author.username.charAt(0).toUpperCase() %></div>
                                <div class="po-review-identity">
                                    <span class="po-review-name"><%= review.author.username %></span>
                                </div>
                            </div>
                            <div class="po-review-stars" aria-label="Rating <%= review.rating %> out of 5">
                                <% for (let i = 1; i <= 5; i++) { %>
                                <i class="fas fa-star<%= i <= review.rating ? '' : ' text-muted' %>"></i>
                                <% } %>
                            </div>
                        </div>
                        <p class="po-review-text"><%= review.body %></p>
                        <% if (currentUser && review.author && typeof review.author.equals === 'function' && review.author.equals(currentUser._id)) { %>
                        <form action="/problems/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                            <button type="submit" class="po-btn-danger-outline po-btn-delete-with-icon">
                                <img src="/images/delete-icon.png" alt="" class="prototype-file-chip__delete-icon" width="14" height="14" aria-hidden="true">
                                <span>Delete</span>
                            </button>
                        </form>
                        <% } %>
                    </article>
                    <% }); %>
                </div>
                <button type="button" class="po-scroll-btn po-scroll-btn--next" aria-label="Scroll reviews right"><i class="fas fa-chevron-right"></i></button>
            </div>
            <% } else { %>
            <p class="po-section-lead" style="margin-bottom:0">No reviews yet. Be the first to share feedback.</p>
            <% } %>
        </section>

        <% if (canEditProject) { %>
        <section class="po-card" aria-label="Problem statement actions">
            <div class="po-statement-actions">
                <a href="/problems/<%= campground._id %>/edit" class="groundwork-submit-btn"><span class="groundwork-submit-btn__text">Edit problem statement</span></a>
                <form class="d-inline" action="/problems/<%= campground._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this problem statement?');">
                    <button type="submit" class="ideation-theme-delete-btn">
                        <img src="/images/delete-icon.png" alt="" class="ideation-delete-btn__icon" width="14" height="14" aria-hidden="true">
                        <span>Delete problem statement</span>
                    </button>
                </form>
            </div>
        </section>
        <% } %>

        <% if (campground.solution) { %>
        <div class="po-solution-banner">
            <p>Your conceptual solution is saved.</p>
            <a href="/solution-details?campgroundId=<%= campground._id %>" class="groundwork-submit-btn"><span class="groundwork-submit-btn__text">View solution</span></a>
        </div>
        <% } %>

        <section class="po-card" aria-labelledby="po-expert-heading">
            <h2 class="po-section-title" id="po-expert-heading">Expert Consultation</h2>
            <p class="po-section-lead po-section-lead--full">Need clarity on the mission? Schedule a session with the problem owners or our innovation mentors to refine your discovery.</p>
            <div class="po-expert-grid">
                <div class="po-expert-column">
                    <button type="button" class="po-expert-card" disabled aria-label="Consult Problem Owner (coming soon)">
                        <span class="po-expert-card-title">Consult Problem Owner</span>
                        <span class="po-expert-status"><span class="po-expert-status-dot" aria-hidden="true"></span> Available</span>
                    </button>
                    <p class="po-expert-hint">Hint: Sync with the industry team to understand the real-world stakes.</p>
                </div>
                <div class="po-expert-column">
                    <button type="button" class="po-expert-card" disabled aria-label="Talk to Innovation Mentor (coming soon)">
                        <span class="po-expert-card-title">Talk to Innovation Mentor</span>
                        <span class="po-expert-status"><span class="po-expert-status-dot" aria-hidden="true"></span> Available</span>
                    </button>
                    <p class="po-expert-hint">Hint: Get help applying the 7-phase methodology to your research.</p>
                </div>
            </div>
        </section>
    </div>
</div>

<script>
(function () {
    var MAX = 5 * 1024 * 1024;
    var form = document.getElementById('po-image-upload-form');
    if (!form) return;
    var input = document.getElementById('po-image-input');
    var dropzone = document.getElementById('poProblemImageDropzone');
    var browseBtn = document.getElementById('poProblemBrowseBtn');
    var fileError = document.getElementById('poProblemFileError');
    var dropzoneFileName = document.getElementById('poDropzoneFileName');
    if (!input || !dropzone) return;

    function validateFiles(files) {
        var invalid = [];
        for (var i = 0; i < files.length; i++) {
            var f = files[i];
            var t = (f.type || '').toLowerCase();
            var ok = t === 'image/jpeg' || t === 'image/png' || /\.(jpe?g|png)$/i.test(f.name);
            if (!ok) invalid.push(f.name + ' unsupported format');
            else if (f.size > MAX) invalid.push(f.name + ' exceeds 5MB');
        }
        return invalid;
    }

    function updateDropzonePreview(files) {
        if (!files || files.length === 0) {
            dropzone.classList.remove('has-file');
            if (dropzoneFileName) dropzoneFileName.textContent = '';
            return;
        }
        dropzone.classList.add('has-file');
        if (dropzoneFileName) {
            dropzoneFileName.textContent = files.length === 1 ? files[0].name : files.length + ' files selected';
        }
    }

    function setFiles(files) {
        var errors = validateFiles(files);
        if (errors.length) {
            input.value = '';
            updateDropzonePreview([]);
            if (fileError) fileError.textContent = errors.join(' | ');
            return false;
        }
        var dt = new DataTransfer();
        files.forEach(function (f) { dt.items.add(f); });
        input.files = dt.files;
        updateDropzonePreview(Array.from(input.files));
        if (fileError) fileError.textContent = '';
        return true;
    }

    input.addEventListener('change', function () {
        setFiles(Array.from(input.files));
    });

    if (browseBtn) browseBtn.addEventListener('click', function () { input.click(); });

    ['dragenter', 'dragover'].forEach(function (ev) {
        dropzone.addEventListener(ev, function (e) {
            e.preventDefault();
            e.stopPropagation();
            dropzone.classList.add('is-dragover');
        });
    });
    ['dragleave', 'drop'].forEach(function (ev) {
        dropzone.addEventListener(ev, function (e) {
            e.preventDefault();
            e.stopPropagation();
            dropzone.classList.remove('is-dragover');
        });
    });
    dropzone.addEventListener('drop', function (e) {
        var dropped = Array.from(e.dataTransfer.files || []);
        if (dropped.length) setFiles(dropped);
    });
})();

(function () {
    var track = document.getElementById('po-reviews-track');
    if (!track) return;
    var step = 280;
    var prev = document.querySelector('.po-scroll-btn--prev');
    var next = document.querySelector('.po-scroll-btn--next');
    var epsilon = 2;

    function setBtnVisibility(btn, shouldShow) {
        if (!btn) return;
        btn.style.display = shouldShow ? 'flex' : 'none';
        btn.setAttribute('aria-hidden', shouldShow ? 'false' : 'true');
        btn.disabled = !shouldShow;
    }

    function updateChevronState() {
        var maxScrollLeft = Math.max(0, track.scrollWidth - track.clientWidth);
        var hasOverflow = maxScrollLeft > epsilon;
        var canScrollLeft = track.scrollLeft > epsilon;
        var canScrollRight = track.scrollLeft < (maxScrollLeft - epsilon);

        setBtnVisibility(prev, hasOverflow && canScrollLeft);
        setBtnVisibility(next, hasOverflow && canScrollRight);
    }

    if (prev) prev.addEventListener('click', function () {
        track.scrollBy({ left: -step, behavior: 'smooth' });
    });
    if (next) next.addEventListener('click', function () {
        track.scrollBy({ left: step, behavior: 'smooth' });
    });
    track.addEventListener('scroll', updateChevronState, { passive: true });
    window.addEventListener('resize', updateChevronState);
    updateChevronState();
})();

(function () {
    var form = document.querySelector('.po-review-form-wrap form.validated-form');
    if (!form) return;
    var MIN_LOADING_MS = 2000;
    var submitBtn = form.querySelector('button[type="submit"]');
    if (!submitBtn) return;
    var reviewsSection = document.querySelector('section[aria-labelledby="po-reviews-heading"]');

    function ensureToastEl() {
        var el = document.getElementById('mission-launch-saved-toast');
        if (!el) {
            el = document.createElement('div');
            el.id = 'mission-launch-saved-toast';
            el.className = 'mission-launch-saved-toast';
            el.setAttribute('role', 'status');
            el.textContent = 'Submitted Successfully!';
            document.body.appendChild(el);
        }
        return el;
    }

    function showSavedToast(message) {
        var el = ensureToastEl();
        el.textContent = message || 'Submitted Successfully!';
        el.classList.remove('mission-launch-saved-toast--hide');
        el.classList.add('mission-launch-saved-toast--show');
        if (el._hideTimer) clearTimeout(el._hideTimer);
        el._hideTimer = setTimeout(function () {
            el.classList.remove('mission-launch-saved-toast--show');
            el.classList.add('mission-launch-saved-toast--hide');
        }, 5000);
    }

    function parseJsonResponse(text) {
        try {
            return text ? JSON.parse(text) : null;
        } catch (e) {
            return null;
        }
    }

    function setButtonLoading(loading) {
        submitBtn.disabled = loading;
        submitBtn.classList.toggle('groundwork-submit-btn--loading', loading);
        submitBtn.setAttribute('aria-busy', loading ? 'true' : 'false');
    }

    function bindCarouselControls(track, prev, next) {
        if (!track || track.dataset.poCarouselBound === '1') return;
        var step = 280;
        var epsilon = 2;
        function setBtnVisibility(btn, shouldShow) {
            if (!btn) return;
            btn.style.display = shouldShow ? 'flex' : 'none';
            btn.setAttribute('aria-hidden', shouldShow ? 'false' : 'true');
            btn.disabled = !shouldShow;
        }
        function updateChevronState() {
            var maxScrollLeft = Math.max(0, track.scrollWidth - track.clientWidth);
            var hasOverflow = maxScrollLeft > epsilon;
            var canScrollLeft = track.scrollLeft > epsilon;
            var canScrollRight = track.scrollLeft < (maxScrollLeft - epsilon);
            setBtnVisibility(prev, hasOverflow && canScrollLeft);
            setBtnVisibility(next, hasOverflow && canScrollRight);
        }
        if (prev) prev.addEventListener('click', function () {
            track.scrollBy({ left: -step, behavior: 'smooth' });
        });
        if (next) next.addEventListener('click', function () {
            track.scrollBy({ left: step, behavior: 'smooth' });
        });
        track.addEventListener('scroll', updateChevronState, { passive: true });
        window.addEventListener('resize', updateChevronState);
        track.dataset.poCarouselBound = '1';
        updateChevronState();
    }

    function ensureReviewsTrack() {
        if (!reviewsSection) return null;
        var existingTrack = document.getElementById('po-reviews-track');
        if (existingTrack) return existingTrack;

        var emptyState = reviewsSection.querySelector('.po-section-lead');
        if (emptyState) emptyState.remove();

        var carousel = document.createElement('div');
        carousel.className = 'po-reviews-carousel';

        var prev = document.createElement('button');
        prev.type = 'button';
        prev.className = 'po-scroll-btn po-scroll-btn--prev';
        prev.setAttribute('aria-label', 'Scroll reviews left');
        prev.innerHTML = '<i class="fas fa-chevron-left"></i>';

        var track = document.createElement('div');
        track.className = 'po-reviews-track';
        track.id = 'po-reviews-track';

        var next = document.createElement('button');
        next.type = 'button';
        next.className = 'po-scroll-btn po-scroll-btn--next';
        next.setAttribute('aria-label', 'Scroll reviews right');
        next.innerHTML = '<i class="fas fa-chevron-right"></i>';

        carousel.appendChild(prev);
        carousel.appendChild(track);
        carousel.appendChild(next);
        reviewsSection.appendChild(carousel);

        bindCarouselControls(track, prev, next);
        return track;
    }

    function addReviewCard(reviewData) {
        var track = ensureReviewsTrack();
        if (!track || !reviewData) return;

        var rating = Math.max(0, Math.min(5, parseInt(reviewData.rating, 10) || 0));
        var body = reviewData.body == null ? '' : String(reviewData.body);
        var username = reviewData.author && reviewData.author.username ? String(reviewData.author.username) : 'You';
        var reviewId = reviewData.id ? String(reviewData.id) : '';

        var article = document.createElement('article');
        article.className = 'po-review-card';

        var top = document.createElement('div');
        top.className = 'po-review-card-top';

        var user = document.createElement('div');
        user.className = 'po-review-user';

        var avatar = document.createElement('div');
        avatar.className = 'po-review-avatar';
        avatar.setAttribute('aria-hidden', 'true');
        avatar.textContent = username ? username.charAt(0).toUpperCase() : 'U';

        var identity = document.createElement('div');
        identity.className = 'po-review-identity';

        var name = document.createElement('span');
        name.className = 'po-review-name';
        name.textContent = username;
        identity.appendChild(name);

        user.appendChild(avatar);
        user.appendChild(identity);

        var stars = document.createElement('div');
        stars.className = 'po-review-stars';
        stars.setAttribute('aria-label', 'Rating ' + rating + ' out of 5');
        for (var i = 1; i <= 5; i++) {
            var star = document.createElement('i');
            star.className = 'fas fa-star' + (i <= rating ? '' : ' text-muted');
            stars.appendChild(star);
        }

        top.appendChild(user);
        top.appendChild(stars);
        article.appendChild(top);

        var text = document.createElement('p');
        text.className = 'po-review-text';
        text.textContent = body;
        article.appendChild(text);

        if (reviewId) {
            var deleteForm = document.createElement('form');
            deleteForm.method = 'POST';
            deleteForm.action = form.getAttribute('action') + '/' + encodeURIComponent(reviewId) + '?_method=DELETE';
            deleteForm.innerHTML = '<button type="submit" class="po-btn-danger-outline po-btn-delete-with-icon"><img src="/images/delete-icon.png" alt="" class="prototype-file-chip__delete-icon" width="14" height="14" aria-hidden="true"><span>Delete</span></button>';
            article.appendChild(deleteForm);
        }

        track.appendChild(article);
        window.dispatchEvent(new Event('resize'));
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            if (typeof form.reportValidity === 'function') form.reportValidity();
            return;
        }
        form.classList.remove('was-validated');

        var start = Date.now();
        setButtonLoading(true);
        var params = new URLSearchParams(new FormData(form));
        fetch(form.getAttribute('action'), {
            method: 'POST',
            body: params,
            credentials: 'same-origin',
            headers: {
                Accept: 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded'
            }
        })
            .then(function (res) {
                return res.text().then(function (text) {
                    return { res: res, data: parseJsonResponse(text) };
                });
            })
            .then(function (ref) {
                var res = ref.res;
                var data = ref.data;
                if (!res.ok || !data || !data.ok) {
                    var msg = data && data.error ? data.error : 'Could not submit review. Please try again.';
                    window.alert(msg);
                    return;
                }
                var elapsed = Date.now() - start;
                var waitMore = Math.max(0, MIN_LOADING_MS - elapsed);
                return new Promise(function (resolve) {
                    setTimeout(resolve, waitMore);
                }).then(function () {
                    form.reset();
                    addReviewCard(data.review);
                    showSavedToast('Submitted Successfully!');
                });
            })
            .catch(function () {
                window.alert('Network error. Please try again.');
            })
            .finally(function () {
                setButtonLoading(false);
            });
    });
})();

(function () {
    var form = document.getElementById('notesForm');
    if (!form) return;
    var MIN_LOADING_MS = 2000;
    var select = document.getElementById('po-note-slot');
    var addBtn = document.getElementById('po-add-note-btn');
    var deleteBtn = document.getElementById('po-delete-note-btn');
    var textarea = form.querySelector('textarea[name="notes"]');
    var payload = document.getElementById('po-notes-payload');
    var submitBtn = form.querySelector('button[type="submit"]');
    var initialStateEl = document.getElementById('po-notes-initial-state');
    var deleteModal = document.getElementById('delete-note-confirm-modal');
    var deleteCancel = document.getElementById('delete-note-confirm-cancel');
    var deleteConfirm = document.getElementById('delete-note-confirm-delete');
    if (!select || !addBtn || !deleteBtn || !textarea || !payload || !submitBtn || !deleteModal || !deleteCancel || !deleteConfirm) return;

    function ensureToastEl() {
        var el = document.getElementById('mission-launch-saved-toast');
        if (!el) {
            el = document.createElement('div');
            el.id = 'mission-launch-saved-toast';
            el.className = 'mission-launch-saved-toast';
            el.setAttribute('role', 'status');
            el.textContent = 'Saved Successfully!';
            document.body.appendChild(el);
        }
        return el;
    }

    function showSavedToast(message) {
        var el = ensureToastEl();
        el.textContent = message || 'Saved Successfully!';
        el.classList.remove('mission-launch-saved-toast--hide');
        el.classList.add('mission-launch-saved-toast--show');
        if (el._hideTimer) clearTimeout(el._hideTimer);
        el._hideTimer = setTimeout(function () {
            el.classList.remove('mission-launch-saved-toast--show');
            el.classList.add('mission-launch-saved-toast--hide');
        }, 5000);
    }

    function parseJsonResponse(text) {
        try {
            return text ? JSON.parse(text) : null;
        } catch (e) {
            return null;
        }
    }

    function setButtonLoading(loading) {
        submitBtn.disabled = loading;
        submitBtn.classList.toggle('groundwork-submit-btn--loading', loading);
        submitBtn.setAttribute('aria-busy', loading ? 'true' : 'false');
    }

    var notesState = [];
    if (initialStateEl && initialStateEl.textContent) {
        try {
            var parsed = JSON.parse(initialStateEl.textContent);
            if (Array.isArray(parsed)) {
                notesState = parsed.map(function (slot) {
                    return typeof slot === 'string' ? slot : '';
                });
            }
        } catch (e) {
            notesState = [];
        }
    }
    if (!notesState.length) {
        for (var i = 0; i < select.options.length; i++) notesState.push('');
    }
    while (notesState.length < select.options.length) notesState.push('');
    var activeIndex = Math.max(0, (parseInt(select.value, 10) || 1) - 1);
    if (typeof notesState[activeIndex] !== 'string') notesState[activeIndex] = '';
    textarea.value = notesState[activeIndex] || '';

    function syncTextareaFromSlot() {
        textarea.value = notesState[activeIndex] || '';
    }

    function persistCurrentSlot() {
        notesState[activeIndex] = textarea.value || '';
    }

    function addSlotOption(slotNumber) {
        var option = document.createElement('option');
        option.value = String(slotNumber);
        option.textContent = 'Note ' + slotNumber;
        select.appendChild(option);
    }

    function rebuildOptions() {
        select.innerHTML = '';
        for (var i = 0; i < notesState.length; i++) addSlotOption(i + 1);
        if (activeIndex < 0) activeIndex = 0;
        if (activeIndex >= notesState.length) activeIndex = notesState.length - 1;
        select.value = String(activeIndex + 1);
        syncTextareaFromSlot();
    }

    function openDeleteModal() {
        deleteModal.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        deleteModal.setAttribute('hidden', '');
        document.body.style.overflow = '';
    }

    function deleteCurrentNote() {
        persistCurrentSlot();
        if (notesState.length > 1) {
            notesState.splice(activeIndex, 1);
            if (activeIndex >= notesState.length) activeIndex = notesState.length - 1;
        } else {
            notesState[0] = '';
            activeIndex = 0;
        }
        rebuildOptions();
        textarea.focus();
    }

    select.addEventListener('change', function () {
        persistCurrentSlot();
        activeIndex = Math.max(0, (parseInt(select.value, 10) || 1) - 1);
        if (typeof notesState[activeIndex] !== 'string') notesState[activeIndex] = '';
        syncTextareaFromSlot();
    });

    addBtn.addEventListener('click', function () {
        persistCurrentSlot();
        notesState.push('');
        var newIndex = notesState.length - 1;
        addSlotOption(newIndex + 1);
        select.value = String(newIndex + 1);
        activeIndex = newIndex;
        syncTextareaFromSlot();
        textarea.focus();
    });

    deleteBtn.addEventListener('click', function () {
        openDeleteModal();
    });

    deleteCancel.addEventListener('click', function () {
        closeDeleteModal();
    });

    deleteConfirm.addEventListener('click', function () {
        deleteCurrentNote();
        closeDeleteModal();
    });

    deleteModal.addEventListener('click', function (e) {
        if (e.target.classList.contains('delete-confirm-backdrop')) closeDeleteModal();
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var start = Date.now();
        setButtonLoading(true);
        persistCurrentSlot();
        payload.value = JSON.stringify(notesState.map(function (slot) {
            return typeof slot === 'string' ? slot : '';
        }));
        var params = new URLSearchParams(new FormData(form));
        params.set('notesAjax', '1');
        fetch(form.getAttribute('action'), {
            method: 'POST',
            body: params,
            credentials: 'same-origin',
            headers: {
                Accept: 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded'
            }
        })
            .then(function (res) {
                return res.text().then(function (text) {
                    return { res: res, data: parseJsonResponse(text) };
                });
            })
            .then(function (ref) {
                var res = ref.res;
                var data = ref.data;
                if (!res.ok || !data || !data.ok) {
                    var msg = data && data.error ? data.error : 'Could not save. Please try again.';
                    window.alert(msg);
                    return;
                }
                var elapsed = Date.now() - start;
                var waitMore = Math.max(0, MIN_LOADING_MS - elapsed);
                return new Promise(function (resolve) {
                    setTimeout(resolve, waitMore);
                }).then(function () {
                    showSavedToast('Saved Successfully!');
                });
            })
            .catch(function () {
                window.alert('Network error. Please try again.');
            })
            .finally(function () {
                setButtonLoading(false);
            });
    });
})();
</script>
