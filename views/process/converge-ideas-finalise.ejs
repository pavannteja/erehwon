<% layout('layouts/boilerplate') %>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="text-white mb-1"><i class="fas fa-circle-check text-warning"></i> Finalise Chose Idea, Define Features</h3>
            <p class="text-muted mb-0">Choose the final idea and define must-have features.</p>
        </div>
        <a href="/process/<%= problem._id %>/converge-ideas" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Converge Ideas
        </a>
    </div>

    <form method="POST" action="/process/<%= problem._id %>/converge-ideas/finalise-chose-idea-define-features">
        <div class="card border-secondary mb-3">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label text-white">Final Chosen Idea (from shortlist)</label>
                    <select name="finalChosenIdeaId" class="form-select">
                        <option value="">Select idea</option>
                        <% (shortlistedIdeas || []).forEach((idea) => { %>
                            <option value="<%= idea._id %>" <%= String(convergeData.finalChosenIdeaId || '') === String(idea._id) ? 'selected' : '' %>>
                                <%= idea.content || '(No idea text)' %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Or write final chosen idea</label>
                    <textarea name="finalChosenIdeaText" rows="3" class="form-control"><%= convergeData.finalChosenIdeaText || '' %></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Define Features (one feature per line)</label>
                    <textarea name="definedFeaturesText" rows="6" class="form-control"><%= (convergeData.definedFeatures || []).join('\n') %></textarea>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-warning">
            <i class="fas fa-save"></i> Save Final Idea and Features
        </button>
    </form>
</div>
