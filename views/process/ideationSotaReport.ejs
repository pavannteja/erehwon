<% layout('layouts/boilerplate') %>
<%
  const pid = problemId;
  const backToPhase = `/process/${pid}/ideation`;
  const solutionCount = sotaState && Array.isArray(sotaState.solutions) ? sotaState.solutions.length : 1;
%>
<div class="excite-enrol-page groundwork-page">
  <div class="groundwork-inner ideation-sota-wrap" data-sota-root>
    <div class="groundwork-tabs">
      <a href="/process/<%= pid %>/ideation/idea-generation" class="groundwork-tab groundwork-tab--nav">
        <span class="groundwork-tab-dot <%= problem.ideationIdeaGenerationSubmitted ? 'groundwork-tab-dot--complete' : 'groundwork-tab-dot--pending' %>" aria-hidden="true"></span>
        <span class="groundwork-tab-label">1. Idea Generation</span>
      </a>
      <span class="groundwork-tab groundwork-tab--active" role="presentation">
        <span class="groundwork-tab-dot <%= sotaSubmitted ? 'groundwork-tab-dot--complete' : 'groundwork-tab-dot--current' %>" aria-hidden="true"></span>
        <span class="groundwork-tab-label">2. SOTA Report</span>
      </span>
    </div>

    <div class="groundwork-header-row ideation-sota-header">
      <h1 class="groundwork-title">SOTA Report</h1>
      <a href="<%= backToPhase %>" class="groundwork-return-link">Return to Phase Overview</a>
    </div>

    <div class="ideation-sota-toolbar">
      <div class="ideation-sota-select-shell">
        <label for="sotaSolutionSelect" class="visually-hidden">Select existing solution</label>
        <select id="sotaSolutionSelect" class="form-select ideation-sota-select" data-sota-select></select>
        <span class="ideation-sota-select-chevron" aria-hidden="true"><i class="bi bi-chevron-down"></i></span>
      </div>
      <button type="button" class="ideation-sota-add-solution" data-sota-add-solution>Add Solution</button>
    </div>

    <div class="groundwork-card ideation-sota-card">
      <form action="/process/<%= pid %>/ideation/sota-report" method="POST" class="ideation-sota-form" data-sota-form>
        <input type="hidden" name="sotaPayload" id="sotaPayloadField" value="">
        <script type="application/json" id="sotaInitialState"><%- sotaStateJson %></script>

        <div class="ideation-sota-panels">
          <section class="ideation-sota-panel ideation-sota-panel--existing">
            <h2 class="ideation-sota-panel__title" data-sota-selected-title>Solution A</h2>
            <div class="ideation-sota-panel__body" data-sota-existing-panel></div>
          </section>

          <section class="ideation-sota-panel ideation-sota-panel--yours">
            <h2 class="ideation-sota-panel__title">Your Solution</h2>
            <div class="ideation-sota-panel__body" data-sota-your-panel></div>
          </section>
        </div>

        <div class="ideation-sota-actions-row mb-3 mt-4">
          <button type="submit" class="groundwork-submit-btn">
            <span class="groundwork-submit-btn__text">Save</span>
            <span class="groundwork-submit-btn__spinner" aria-hidden="true"></span>
          </button>
          <button
            type="button"
            class="ideation-sota-delete-solution-btn"
            id="delete-sota-solution-trigger"
            data-ideation-delete-sota-solution
            aria-haspopup="dialog"
            aria-controls="delete-sota-solution-confirm-modal"
            <%= solutionCount < 2 ? 'hidden' : '' %>
          >
            <img src="/images/delete-icon.png" alt="" class="ideation-delete-btn__icon" aria-hidden="true">
            <span>Delete Solution</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<div id="delete-sota-solution-confirm-modal" class="delete-confirm-overlay" role="dialog" aria-modal="true" aria-labelledby="delete-sota-solution-confirm-title" aria-describedby="delete-sota-solution-confirm-desc" hidden>
  <div class="delete-confirm-backdrop"></div>
  <div class="delete-confirm-dialog">
    <h3 id="delete-sota-solution-confirm-title" class="delete-confirm-title">Confirm delete</h3>
    <p id="delete-sota-solution-confirm-desc" class="delete-confirm-question">Are you sure you want to delete this solution?</p>
    <div class="delete-confirm-actions">
      <button type="button" class="delete-confirm-cancel" id="delete-sota-solution-confirm-cancel">Cancel</button>
      <button type="button" class="delete-confirm-delete" id="delete-sota-solution-confirm-delete">Delete</button>
    </div>
  </div>
</div>
<script src="/javascripts/ideationSotaReport.js"></script>
