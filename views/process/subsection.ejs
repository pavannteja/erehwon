<% layout('layouts/boilerplate') %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-secondary">
                <div class="card-body p-4">
                    <h3 class="text-white mb-2">
                        <i class="fas fa-layer-group text-warning"></i> <%= stageName %> - <%= subsectionName %>
                    </h3>
                    <p class="text-muted mb-4">
                        This subsection page is ready for adding specific workflows, forms, analytics, and assessments.
                    </p>

                    <div class="alert alert-dark border border-secondary mb-4">
                        <div class="text-white mb-1">Project:</div>
                        <div class="text-muted"><%= problem.title %></div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <a href="/process/<%= problem._id %>/<%= stageKey %>" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Stage Hub
                        </a>
                        <a href="/problems/<%= problem._id %>" class="btn btn-warning">
                            <i class="fas fa-diagram-project"></i> Back to Project
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
